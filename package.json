  "keywords": [
    "pihole",
    "telegram",
    "bot",
    "pi-hole",
    "controller",
    "dns",
    "ad-blocker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AdrianoCng/pihole-telegram-bot"
  },
  "homepage": "https://github.com/AdrianoCng/pihole-telegram-bot#readme",
  "bugs": {
    "url": "https://github.com/AdrianoCng/pihole-telegram-bot/issues"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "telegraf": "^4.12.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.2",
    "nodemon": "^3.1.7",
    "vitest": "5.0.2"
  }

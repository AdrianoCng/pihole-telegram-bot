{
  "name": "pihole-telegram-bot",
  "type": "module",
  "version": "1.2.2",
  "description": "Control your pihole with this telegram bot",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:prod": "pm2 start index.js --name pihole-telegram-bot",
    "dev": "nodemon index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "author": "Adriano Cangiamila",
